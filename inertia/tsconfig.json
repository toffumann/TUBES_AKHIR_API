{
  "extends": "@adonisjs/tsconfig/tsconfig.client.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "jsx": "react-jsx",
     "forceConsistentCasingInFileNames": false,  
    "skipLibCheck": true, 
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
   "exclude": [                                
    "node_modules",
    "dist",
    "build"
  ]
}
