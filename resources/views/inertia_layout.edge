{{-- resources/views/inertia_layout.edge --}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <title inertia>
    @if(title)
      {{ title }} - DesainHub
    @else
      DesainHub
    @endif
  </title>
  
  {{-- Vite assets --}}
  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app/app.tsx'])
</head>

<body class="min-h-screen bg-gray-50">
  @inertia()
</body>
</html>